{
  "root": true,
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "requireConfigFile": false,
    "babelOptions": {
      "presets": [
        "@babel/preset-env",
        "@babel/preset-react"
      ]
    }
  },
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "globals": {
    "$": "readonly",
    "jQuery": "readonly",
    "React": "readonly",
    "ReactDOM": "readonly",
    "THREE": "readonly",
    "grained": "readonly"
  },
  "rules": {
    "no-constant-condition": "error",
    "no-unreachable": "error"
  }
}
